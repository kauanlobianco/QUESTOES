# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Dashboard → Project Settings → API). Supabase local: `npx supabase status`.

# Navegador (públicas)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Servidor (/api/game). NUNCA prefixar com VITE_: a service role ignora o RLS.
SUPABASE_SERVICE_ROLE_KEY=
